fin() {
	[ -n "${report_individual_builds:-}" ] && printf '\e[32m\e[1mBuilt\e[0m %s\n' "$1"
}

print_verbose () {
	[ -n "${generate_verbose:-}" ] && printf "$@"
}

clean_markup() {
	local -n ptr=${1}
	ptr=${ptr//'<span class="reset">'/}
	ptr=${ptr//'</span>'/}
	ptr=${ptr#*'<h1'*'>'}
	ptr=${ptr%'</h1>'*}
	ptr=${ptr//'}'/}
	ptr=${ptr//'{'/}
	ptr=${ptr//'<img'*'>'/}
}

slugify() {
	echo "$1" | iconv -c -t ascii//TRANSLIT | sed -E 's/[~^]+//g' | sed -E 's/[^a-zA-Z0-9]+/-/g' | sed -E 's/^-+|-+$//g' | tr A-Z a-z
}

base_url="https://nes.is-a.dev/"
default_description="My little corner of the internet — notes on hardware, software, and whatever else I'm tinkering with."
default_image="https://nes.is-a.dev/assets/images/nes-export.avif"
format_doc_heading() {
	doc_path=${1#'./src/'}
	doc_path=${doc_path%'.'*}

	[[ "$markup" =~ \<h1\>(.*)\<\/h1\> ]] # uses variable from parent here
	doc_title=${BASH_REMATCH[1]}
	clean_markup doc_title

	doc_url=$1
	doc_url=${doc_url/"./${output_dir}/"/"$base_url"}

	doc_description=$(grep -Po '<!--\s*post_description=\K.*(?=-->)' <<<"$markup" | head -n1)
	doc_description=${doc_description//'"'/}
	doc_description="${doc_description%"${doc_description##*[![:space:]]}"}"
	[ -z "$doc_description" ] && doc_description="$default_description"

	doc_image=$(grep -Po '<!--\s*post_image=\K.*(?=-->)' <<<"$markup" | head -n1)
	doc_image=${doc_image//'"'/}
	doc_image="${doc_image%"${doc_image##*[![:space:]]}"}"
	if [ -n "$doc_image" ]; then
		[[ "$doc_image" == http* ]] || doc_image="${base_url%/}${doc_image}"
	else
		doc_image="$default_image"
	fi

	doc_heading=${template_pre_content/'!DOCUMENT-PATH!'/"$doc_path"}
	doc_heading=${doc_heading//'!TITLE!'/"$doc_title"}
	doc_heading=${doc_heading//'!URL!'/"${doc_url}"}
	doc_heading=${doc_heading//'!DESCRIPTION!'/"${doc_description}"}
	doc_heading=${doc_heading//'!IMAGE!'/"${doc_image}"}
}

# Tasks:
build_md() {
	out=${1/src/"$output_dir"}
	out=${out/.md/.html}
	markup=""
	if [ "$is_in_ricing_guide" -eq 1 ]; then
		markup="$(uv run ./.tooling/gfm.py "$1")"
	else
		markup=$(quiet=true bash ./.tooling/pond.sh "$1")
	fi
	format_doc_heading "$out" "$1"
	mkdir -p "$(dirname "$out")"
	if [ -z "$GENERATE_NO_OPTIMIZE_PAGE" ]; then
		printf '%s\n%s\n%s' "$doc_heading" "$markup" "$template_post_content" \
		 | bash ./assets_src/.tooling/optimize_page.sh --stdin >"$out"
	else
		printf '%s\n%s\n%s' "$doc_heading" "$markup" "$template_post_content" > "$out"
	fi
	fin "$1"
}

build_html() {
	out=${1/src/"$output_dir"}
	cp "$1" "$out"
	fin "$1"
}

#=======================
# Generic Build Function
#=======================

build() {
	local file=$1
	local start_time=$(date +%s%3N)
	case "${file##*.}" in
	'org')
		build_org "$file"
		;;
	'html')
		build_html "$file" &
		;;
	'md')
		build_md "$file" &
		;;
	*)
		return
		;;
	esac
	local end_time=$(date +%s%3N)
	local elapsed=$((end_time - start_time))
	print_verbose "\e[32mGENERATED\e[0m %s in %dms\n" "$file" "$elapsed"
}

generate_org_full() {
	emacs "${emacs_arguments[@]}" >/dev/null 2>&1
}

# Resolve the source file (.md/.org/.html) an out/ file was built from, and
# return its "publish date" as a unix epoch. Prefers an explicit
# `#header ... date=YYYY-MM-DD` override (emitted as a post_date HTML
# comment) since git history can be wrong for renamed/rewritten files; falls
# back to the file's first git commit date, then mtime.
get_article_date() {
	local out_file="$1"

	local override
	override=$(grep -Po '<!--\s*post_date=\K.*(?=-->)' "$out_file" 2>/dev/null | head -n1)
	override=${override//\"/}
	override="${override#"${override%%[![:space:]]*}"}"
	override="${override%"${override##*[![:space:]]}"}"
	if [ -n "$override" ]; then
		local override_epoch
		override_epoch=$(date -d "$override" +%s 2>/dev/null)
		[ -n "$override_epoch" ] && { printf '%s' "$override_epoch"; return; }
	fi

	local base="${out_file#"$output_dir"/}"
	base="src/${base%.html}"
	local src=""
	for ext in md org html; do
		if [ -f "${base}.${ext}" ]; then
			src="${base}.${ext}"
			break
		fi
	done

	local date_epoch=""
	if [ -n "$src" ]; then
		date_epoch=$(git log --follow --diff-filter=A --format=%at -- "$src" 2>/dev/null | tail -1)
		[ -z "$date_epoch" ] && date_epoch=$(stat -c %Y "$src" 2>/dev/null)
	fi
	[ -z "$date_epoch" ] && date_epoch=$(stat -c %Y "$out_file" 2>/dev/null)
	printf '%s' "${date_epoch:-0}"
}

generate_index() {
	cp ./src/index.html ./$output_dir/index.tmp.html 2>/dev/null

	# Note: folder iteration order doesn't matter here — each folder's posts
	# are substituted into a fixed !POSTS-<YEAR>! placeholder position in the
	# template (src/index.html), so only the per-article sort below (by date,
	# newest first) affects the rendered page.
	while read -r folder; do
		local posts=""
		local article_lines=""
		while read -r match; do
			file=${match%%:*}
			d=$(get_article_date "$file")
			article_lines+="${d}	${match}"$'\n'
		done < <(grep -ProH -m 1 '<h1.*?>.*</h1>' "${folder}")

		while IFS=$'\t' read -r d match; do
			[ -z "$match" ] && continue
			file=${match%%:*}
			title=${match#*:}

			# clean the <h1> markup
			clean_markup title

			# extract post_description from HTML comment
			desc=$(grep -Po '<!--\s*post_description=\K.*(?=-->)' "$file" | head -n1)
			image=$(grep -Po '<!--\s*post_image=\K.*(?=-->)' "$file" | head -n1)

			[ -z "${title/ /}" ] && continue

			posts+="<li>"
			if [ -n "$image" ]; then
				posts+="<img loading='lazy' class='img-pxl' src='${image//'"'/}' alt='Post Image' />"
			fi
			posts+="<div><a class='special' href='/$file'>$title</a>"
			[ -n "$desc" ] && posts+="<p class='description'>${desc//'"'/}</p>"
			posts+="</div></li>"$'\n'

		done < <(printf '%s' "$article_lines" | sort -t $'\t' -k1,1 -rn)

		folder=${folder#*/}
		# Plain prefix/suffix split, not sed and not ${var//pat/repl}: both
		# treat a bare '&' in the replacement as "insert the whole match"
		# (sed's own rule; bash's patsub_replacement shopt copies it), so any
		# post title containing an escaped ampersand (&amp;, see the
		# #HEADER transformer) would get the placeholder itself spliced back
		# into the output. %%/# pattern trimming has no such substitution
		# text, so it's immune.
		placeholder="!POSTS-${folder^^}!"
		index_tmp_content=$(<"./$output_dir/index.tmp.html")
		# Folders with no matching placeholder in the template (.assets,
		# todo) must leave the content untouched — when the pattern doesn't
		# match, %%/# trimming both return the string as-is, so blindly
		# reassembling prefix+posts+suffix would double the whole file.
		if [[ "$index_tmp_content" == *"$placeholder"* ]]; then
			index_tmp_content="${index_tmp_content%%"$placeholder"*}${posts}${index_tmp_content#*"$placeholder"}"
			printf '%s\n' "$index_tmp_content" > "./$output_dir/index.tmp.html"
		fi
	done < <(find "$output_dir"/ -maxdepth 1 -type d -not -path "$output_dir/")

	if [ -n "$GENERATE_NO_OPTIMIZE_PAGE" ]; then
		mv "./$output_dir/index.tmp.html" "./$output_dir/index.html"
	else
		bash ./assets_src/.tooling/optimize_page.sh -i "./$output_dir/index.tmp.html" -o "$output_dir/index.html"
		rm "./$output_dir/index.tmp.html"
	fi

	cp ./$output_dir/index.html ./index.html
	# ln -sf ./$output_dir/index.html ./index.html
}


generate_rss() {
	local rss_file="./rss.xml"
	local site_url="https://nes.is-a.dev"
	local site_title="Nes's Personal Site"
	local site_description="My little corner of the internet"
	local pub_date=$(date -R)

	{
		echo '<?xml version="1.0" encoding="UTF-8" ?>'
		echo '<rss version="2.0">'
		echo '    <channel>'
		echo "        <title>$site_title</title>"
		echo "        <link>$site_url</link>"
		echo "        <description>$site_description</description>"
		echo "        <language>en-us</language>"
		echo "        <pubDate>$pub_date</pubDate>"
		echo "        <lastBuildDate>$pub_date</lastBuildDate>"
	} >$rss_file

	# Collect every article across all year-folders with its date, then emit
	# newest-first — RSS readers expect feed items in that order.
	local article_lines=""
	while read -r folder; do
		while read -r match; do
			file=${match%%:*}
			d=$(get_article_date "$file")
			article_lines+="${d}	${match}"$'\n'
		done < <(grep -ProH '<h1.*?>.*</h1>' "${folder}")
	done < <(find "$output_dir"/ -maxdepth 1 -type d -not -path "$output_dir/")

	while IFS=$'\t' read -r d match; do
		[ -z "$match" ] && continue
		file=${match%%:*}
		title=${match#*:}

		clean_markup title

		[ -z "${title/ /}" ] && continue

		item_link="$site_url/${file#$output_dir/}"
		item_pub_date=$(date -R -d "@${d}")

		item_desc=$(grep -Po '<!--\s*post_description=\K.*(?=-->)' "$file" | head -n1)
		item_desc=${item_desc//'"'/}
		item_desc="${item_desc%"${item_desc##*[![:space:]]}"}"
		[ -z "$item_desc" ] && item_desc="$title"

		{
			echo '        <item>'
			echo "            <title>$title</title>"
			echo "            <link>$item_link</link>"
			echo "            <description>$item_desc</description>"
			echo "            <pubDate>$item_pub_date</pubDate>"
			echo "            <guid>$item_link</guid>"
			echo '        </item>'
		} >>$rss_file
	done < <(printf '%s' "$article_lines" | sort -t $'\t' -k1,1 -rn)

	{
		echo '    </channel>'
		echo '</rss>'
	} >>$rss_file
}

generate_sitemap() {
	local sitemap_file="./sitemap.xml"
	local site_url="https://nes.is-a.dev"
	local now
	now=$(date -u +%Y-%m-%d)

	{
		echo '<?xml version="1.0" encoding="UTF-8" ?>'
		echo '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">'
		echo "    <url><loc>${site_url}/</loc><lastmod>${now}</lastmod></url>"
		echo "    <url><loc>${site_url}/about.html</loc><lastmod>${now}</lastmod></url>"
		echo "    <url><loc>${site_url}/portfolio.html</loc><lastmod>${now}</lastmod></url>"
	} >$sitemap_file

	local article_lines=""
	while read -r folder; do
		while read -r match; do
			file=${match%%:*}
			d=$(get_article_date "$file")
			article_lines+="${d}	${match}"$'\n'
		done < <(grep -ProH -m 1 '<h1.*?>.*</h1>' "${folder}")
	done < <(find "$output_dir"/ -maxdepth 1 -type d -not -path "$output_dir/")

	while IFS=$'\t' read -r d match; do
		[ -z "$match" ] && continue
		file=${match%%:*}

		local page_url="$site_url/${file#$output_dir/}"
		local lastmod
		lastmod=$(date -u -d "@${d}" +%Y-%m-%d 2>/dev/null)
		[ -z "$lastmod" ] && lastmod="$now"

		echo "    <url><loc>${page_url}</loc><lastmod>${lastmod}</lastmod></url>" >>$sitemap_file
	done < <(printf '%s' "$article_lines" | sort -t $'\t' -k1,1 -rn)

	# experiments/ — hand-written static HTML, not built into out/ but still
	# public pages (index, icon-creator, FSA, serial, etc.). Add every *.html
	# under experiments/ so they appear in sitemap.xml.
	if [ -d "experiments" ]; then
		while IFS= read -r exp_file; do
			[ -z "$exp_file" ] && continue
			# lastmod from git first commit, fallback to mtime
			local exp_epoch
			exp_epoch=$(git log --follow --diff-filter=A --format=%at -- "$exp_file" 2>/dev/null | tail -1)
			[ -z "$exp_epoch" ] && exp_epoch=$(stat -c %Y "$exp_file" 2>/dev/null)
			[ -z "$exp_epoch" ] && exp_epoch=$(date +%s)
			local exp_lastmod
			exp_lastmod=$(date -u -d "@${exp_epoch}" +%Y-%m-%d 2>/dev/null)
			[ -z "$exp_lastmod" ] && exp_lastmod="$now"
			local exp_url="$site_url/${exp_file}"
			echo "    <url><loc>${exp_url}</loc><lastmod>${exp_lastmod}</lastmod></url>" >>$sitemap_file
		done < <(find experiments -type f -name "*.html" | sort)
	fi

	echo '</urlset>' >>$sitemap_file
}


#!/usr/bin/env bash

# When invoked outside a container, delegate to the long-running Docker container.
if [ ! -f /.dockerenv ]; then
    docker compose up -d generate || { echo "Failed to start docker container" >&2; exit 1; }
    # Wait for bun install (first start only — instant on subsequent calls)
    timeout=30
    while ! docker compose exec generate test -d node_modules 2>/dev/null; do
        sleep 0.5
        timeout=$((timeout - 1))
        if [ "$timeout" -le 0 ]; then
            echo "Timed out waiting for container to initialize" >&2
            exit 1
        fi
    done
    exec docker compose exec generate ./generate "$@"
fi


html_optimize_file () {
		local file="$1"
		tmpfile=$(mktemp)
		${node_runner} html-minifier-terser \
			--collapse-whitespace \
			--remove-comments \
			--remove-optional-tags \
			--remove-redundant-attributes \
			--remove-script-type-attributes \
			--remove-style-link-type-attributes \
			--use-short-doctype \
			--minify-css true \
			--minify-js true \
			"$file" -o "$tmpfile" 2>/dev/null && mv "$tmpfile" "$file"
}

perform_html_optimization () {
	OUT_DIR="out"

# Loop through all .html files in OUT_DIR
find "$OUT_DIR" -type f -name "*.html" | while read -r file; do
    # echo "Minifying: $file
	html_optimize_file "$file"
done

html_optimize_file "./index.html"
}

perform_css_optimization () {
	# This function is not used in the current context, but can be used to optimize CSS files
	# echo "Performing CSS optimization..."
	${node_runner} postcss ./assets_src/styles/styles.css --output ./out/.assets/styles.css
}

